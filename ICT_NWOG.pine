//@version=6
indicator('ICT + NWOG', shorttitle = 'ICT+NWOG', overlay = true, max_lines_count = 500, max_labels_count = 500)

// ============================== ON / OFF ==============================
grpToggles = 'On / Off'

showAsiaHigh = input.bool(true, 'Asia High', group = grpToggles)
showAsiaLow = input.bool(true, 'Asia Low', group = grpToggles)
showLondonHigh = input.bool(true, 'London High', group = grpToggles)
showLondonLow = input.bool(true, 'London Low', group = grpToggles)
showMidnightOpen = input.bool(true, 'Midnight Open', group = grpToggles, tooltip = 'Price at the 00:00 New York open, extended right')
showOpen2 = input.bool(true, '08:30 Open', group = grpToggles, tooltip = 'Price at the 08:30 New York open, extended right')
showPDH = input.bool(true, 'Prev Day High', group = grpToggles)
showPDL = input.bool(true, 'Prev Day Low', group = grpToggles)
showPWH = input.bool(true, 'Prev Week High', group = grpToggles)
showPWL = input.bool(true, 'Prev Week Low', group = grpToggles)
show_ndog = input.bool(true, 'NDOG (New Day Opening Gap)', group = grpToggles)
show_nwog = input.bool(true, 'NWOG (New Week Opening Gap)', group = grpToggles)
extendRight = input.bool(true, 'Extend Lines To The Right', group = grpToggles, tooltip = 'On = lines follow price and end where the text sits. Off = lines stop a fixed number of bars after the RTH open.')
showLabelBackground = input.bool(false, 'Show Label Background', group = grpToggles)
// ======================================================================


// ============================== GENERAL ===============================
grpGeneral = 'General'

asiaSession = input.session('1800-0150', 'Asia Session (NY Time)', group = grpGeneral)
londonSession = input.session('0200-0930', 'London Session (NY Time)', group = grpGeneral)
sessionTz = input.string('America/New_York', 'Session Time Zone', group = grpGeneral)
lineWidth = input.int(1, 'Line Width', minval = 1, maxval = 10, group = grpGeneral)
extendBars = input.int(120, 'Line Length After RTH Open (Bars)', minval = 1, maxval = 1000, group = grpGeneral, tooltip = 'Only used when Extend Lines To The Right is off')
// ======================================================================


// ============================== LABELS ================================
grpLabels = 'Labels'

labelTextColor = input.color(color.rgb(66, 64, 64), 'Label Text Color', group = grpLabels)
labelSizeInput = input.int(2, 'Label Size: 0=tiny, 1=small, 2=normal, 3=large, 4=huge', minval = 0, maxval = 4, group = grpLabels)
labelOffsetTicks = input.int(0, 'Label Offset Below Line (Ticks)', minval = 0, group = grpLabels)
labelOffsetBars = input.int(40, 'Label Distance Right Of Last Bar (Bars)', minval = 0, maxval = 500, group = grpLabels, tooltip = 'How far to the right of the current bar the text sits. 0 = right on the last bar.')
// ======================================================================


// =========================== ASIA / LONDON ============================
grpSessions = 'Asia / London'

asiaHighColor = input.color(color.new(color.teal, 0), 'Asia High Color', group = grpSessions)
asiaLowColor = input.color(color.new(color.teal, 0), 'Asia Low Color', group = grpSessions)
asiaHighText = input.string('Asia High', 'Asia High Text', group = grpSessions)
asiaLowText = input.string('Asia Low', 'Asia Low Text', group = grpSessions)
asiaLabelBgColor = input.color(color.new(color.teal, 0), 'Asia Label Background', group = grpSessions)

londonHighColor = input.color(color.new(color.orange, 0), 'London High Color', group = grpSessions)
londonLowColor = input.color(color.new(color.orange, 0), 'London Low Color', group = grpSessions)
londonHighText = input.string('London High', 'London High Text', group = grpSessions)
londonLowText = input.string('London Low', 'London Low Text', group = grpSessions)
londonLabelBgColor = input.color(color.new(color.orange, 0), 'London Label Background', group = grpSessions)
// ======================================================================


// ============================== NY OPENS ==============================
grpOpens = 'NY Opens'

midnightHour = input.int(0, 'Midnight Open Hour (NY)', minval = 0, maxval = 23, group = grpOpens)
midnightMinute = input.int(0, 'Midnight Open Minute', minval = 0, maxval = 59, group = grpOpens)
midnightColor = input.color(color.new(#7eceb6, 0), 'Midnight Open Color', group = grpOpens)
midnightText = input.string('Midnight Open', 'Midnight Open Text', group = grpOpens)
midnightBgColor = input.color(color.new(#99dec9, 0), 'Midnight Label Background', group = grpOpens)

open2Hour = input.int(8, '08:30 Open Hour (NY)', minval = 0, maxval = 23, group = grpOpens)
open2Minute = input.int(30, '08:30 Open Minute', minval = 0, maxval = 59, group = grpOpens)
open2Color = input.color(color.new(#4075d1, 0), '08:30 Open Color', group = grpOpens)
open2Text = input.string('8:30 Open', '08:30 Open Text', group = grpOpens)
open2BgColor = input.color(color.new(#4075d1, 0), '08:30 Label Background', group = grpOpens)

openLineWidth = input.int(1, 'Open Line Width', minval = 1, maxval = 10, group = grpOpens)
openLineStyleInput = input.string('Dashed', 'Open Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = grpOpens)
// ======================================================================


// ======================= PREVIOUS DAY / WEEK ==========================
grpPrev = 'Previous Day / Week'

pdhColor = input.color(color.new(#27b06c, 0), 'Previous Day High Color', group = grpPrev)
pdlColor = input.color(color.new(#27b06c, 0), 'Previous Day Low Color', group = grpPrev)
pwhColor = input.color(color.new(color.blue, 0), 'Previous Week High Color', group = grpPrev)
pwlColor = input.color(color.new(color.blue, 0), 'Previous Week Low Color', group = grpPrev)

pdhText = input.string('PDHs', 'Previous Day High Text', group = grpPrev)
pdlText = input.string('PDLs', 'Previous Day Low Text', group = grpPrev)
pwhText = input.string('PWHs', 'Previous Week High Text', group = grpPrev)
pwlText = input.string('PWLs', 'Previous Week Low Text', group = grpPrev)

prevDayBgColor = input.color(color.new(#27b06c, 0), 'Previous Day Label Background', group = grpPrev)
prevWeekBgColor = input.color(color.new(color.blue, 0), 'Previous Week Label Background', group = grpPrev)
// ======================================================================


inAsia = not na(time(timeframe.period, asiaSession, sessionTz))
inLondon = not na(time(timeframe.period, londonSession, sessionTz))

asiaStart = inAsia and not inAsia[1]
asiaEnd = not inAsia and inAsia[1]
londonStart = inLondon and not inLondon[1]
londonEnd = not inLondon and inLondon[1]

var float asiaHigh = na
var float asiaLow = na
var float londonHigh = na
var float londonLow = na

var int asiaHighBar = na
var int asiaLowBar = na
var int londonHighBar = na
var int londonLowBar = na

var line asiaHighLine = na
var line asiaLowLine = na
var line londonHighLine = na
var line londonLowLine = na

var label asiaHighLabel = na
var label asiaLowLabel = na
var label londonHighLabel = na
var label londonLowLabel = na

asiaLabelColor = showLabelBackground ? asiaLabelBgColor : color.new(color.white, 100)
londonLabelColor = showLabelBackground ? londonLabelBgColor : color.new(color.white, 100)
labelOffsetPrice = syminfo.mintick * labelOffsetTicks
labelSize = labelSizeInput == 0 ? size.tiny : labelSizeInput == 1 ? size.small : labelSizeInput == 2 ? size.normal : labelSizeInput == 3 ? size.large : size.huge

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaHighBar := bar_index
    asiaLowBar := bar_index
    asiaLowBar
else if inAsia
    if high >= nz(asiaHigh, high)
        asiaHigh := high
        asiaHighBar := bar_index
        asiaHighBar
    if low <= nz(asiaLow, low)
        asiaLow := low
        asiaLowBar := bar_index
        asiaLowBar

if londonStart
    londonHigh := high
    londonLow := low
    londonHighBar := bar_index
    londonLowBar := bar_index
    londonLowBar
else if inLondon
    if high >= nz(londonHigh, high)
        londonHigh := high
        londonHighBar := bar_index
        londonHighBar
    if low <= nz(londonLow, low)
        londonLow := low
        londonLowBar := bar_index
        londonLowBar

// lines + text are drawn when the session starts and follow the developing high/low while the session is still running
if asiaStart
    line.delete(asiaHighLine)
    line.delete(asiaLowLine)
    label.delete(asiaHighLabel)
    label.delete(asiaLowLabel)

    asiaHighLine := na
    asiaLowLine := na
    asiaHighLabel := na
    asiaLowLabel := na

    if showAsiaHigh
        asiaHighEnd = extendRight ? bar_index + labelOffsetBars : asiaHighBar + extendBars
        asiaHighLine := line.new(asiaHighBar, asiaHigh, asiaHighEnd, asiaHigh, color = asiaHighColor, width = lineWidth, extend = extend.none)
        asiaHighLabel := label.new(bar_index + labelOffsetBars, asiaHigh - labelOffsetPrice, asiaHighText, style = label.style_label_left, textcolor = labelTextColor, color = asiaLabelColor, size = labelSize)
        asiaHighLabel
    if showAsiaLow
        asiaLowEnd = extendRight ? bar_index + labelOffsetBars : asiaLowBar + extendBars
        asiaLowLine := line.new(asiaLowBar, asiaLow, asiaLowEnd, asiaLow, color = asiaLowColor, width = lineWidth, extend = extend.none)
        asiaLowLabel := label.new(bar_index + labelOffsetBars, asiaLow - labelOffsetPrice, asiaLowText, style = label.style_label_left, textcolor = labelTextColor, color = asiaLabelColor, size = labelSize)
        asiaLowLabel
else if inAsia
    if not na(asiaHighLine)
        line.set_xy1(asiaHighLine, asiaHighBar, asiaHigh)
        line.set_y2(asiaHighLine, asiaHigh)
        if not extendRight
            line.set_x2(asiaHighLine, asiaHighBar + extendBars)
    if not na(asiaLowLine)
        line.set_xy1(asiaLowLine, asiaLowBar, asiaLow)
        line.set_y2(asiaLowLine, asiaLow)
        if not extendRight
            line.set_x2(asiaLowLine, asiaLowBar + extendBars)

if londonStart
    line.delete(londonHighLine)
    line.delete(londonLowLine)
    label.delete(londonHighLabel)
    label.delete(londonLowLabel)

    londonHighLine := na
    londonLowLine := na
    londonHighLabel := na
    londonLowLabel := na

    if showLondonHigh
        londonHighEnd = extendRight ? bar_index + labelOffsetBars : londonHighBar + extendBars
        londonHighLine := line.new(londonHighBar, londonHigh, londonHighEnd, londonHigh, color = londonHighColor, width = lineWidth, extend = extend.none)
        londonHighLabel := label.new(bar_index + labelOffsetBars, londonHigh - labelOffsetPrice, londonHighText, style = label.style_label_left, textcolor = labelTextColor, color = londonLabelColor, size = labelSize)
        londonHighLabel
    if showLondonLow
        londonLowEnd = extendRight ? bar_index + labelOffsetBars : londonLowBar + extendBars
        londonLowLine := line.new(londonLowBar, londonLow, londonLowEnd, londonLow, color = londonLowColor, width = lineWidth, extend = extend.none)
        londonLowLabel := label.new(bar_index + labelOffsetBars, londonLow - labelOffsetPrice, londonLowText, style = label.style_label_left, textcolor = labelTextColor, color = londonLabelColor, size = labelSize)
        londonLowLabel
else if inLondon
    if not na(londonHighLine)
        line.set_xy1(londonHighLine, londonHighBar, londonHigh)
        line.set_y2(londonHighLine, londonHigh)
        if not extendRight
            line.set_x2(londonHighLine, londonHighBar + extendBars)
    if not na(londonLowLine)
        line.set_xy1(londonLowLine, londonLowBar, londonLow)
        line.set_y2(londonLowLine, londonLow)
        if not extendRight
            line.set_x2(londonLowLine, londonLowBar + extendBars)

// ================= NY OPEN LEVELS (00:00 and 08:30 NY) =================
openLineStyle = openLineStyleInput == 'Solid' ? line.style_solid : openLineStyleInput == 'Dashed' ? line.style_dashed : line.style_dotted
midnightLabelColor = showLabelBackground ? midnightBgColor : color.new(color.white, 100)
open2LabelColor = showLabelBackground ? open2BgColor : color.new(color.white, 100)

nyMinuteOfDay = hour(time, sessionTz) * 60 + minute(time, sessionTz)
newNyDay = na(time[1]) or dayofmonth(time, sessionTz) != dayofmonth(time[1], sessionTz)

midnightTarget = midnightHour * 60 + midnightMinute
open2Target = open2Hour * 60 + open2Minute

// first bar of the NY day at or after the target time
midnightTrigger = newNyDay ? nyMinuteOfDay >= midnightTarget : nyMinuteOfDay >= midnightTarget and nyMinuteOfDay[1] < midnightTarget
open2Trigger = newNyDay ? nyMinuteOfDay >= open2Target : nyMinuteOfDay >= open2Target and nyMinuteOfDay[1] < open2Target

var float midnightPrice = na
var float open2Price = na
var line midnightLine = na
var line open2Line = na
var label midnightLabel = na
var label open2Label = na

if midnightTrigger
    midnightPrice := open
    line.delete(midnightLine)
    label.delete(midnightLabel)
    midnightLine := na
    midnightLabel := na

    if showMidnightOpen
        midnightEnd = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        midnightLine := line.new(bar_index, midnightPrice, midnightEnd, midnightPrice, color = midnightColor, width = openLineWidth, style = openLineStyle, extend = extend.none)
        midnightLabel := label.new(bar_index + labelOffsetBars, midnightPrice - labelOffsetPrice, midnightText, style = label.style_label_left, textcolor = labelTextColor, color = midnightLabelColor, size = labelSize)
        midnightLabel

if open2Trigger
    open2Price := open
    line.delete(open2Line)
    label.delete(open2Label)
    open2Line := na
    open2Label := na

    if showOpen2
        open2End = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        open2Line := line.new(bar_index, open2Price, open2End, open2Price, color = open2Color, width = openLineWidth, style = openLineStyle, extend = extend.none)
        open2Label := label.new(bar_index + labelOffsetBars, open2Price - labelOffsetPrice, open2Text, style = label.style_label_left, textcolor = labelTextColor, color = open2LabelColor, size = labelSize)
        open2Label

if not showMidnightOpen and not na(midnightLine)
    line.delete(midnightLine)
    label.delete(midnightLabel)
    midnightLine := na
    midnightLabel := na
    midnightLabel

if not showOpen2 and not na(open2Line)
    line.delete(open2Line)
    label.delete(open2Label)
    open2Line := na
    open2Label := na
    open2Label
    // =======================================================================


// ==================== PREVIOUS DAY / WEEK HIGH & LOW ====================
prevDayLabelColor = showLabelBackground ? prevDayBgColor : color.new(color.white, 100)
prevWeekLabelColor = showLabelBackground ? prevWeekBgColor : color.new(color.white, 100)

newDay = timeframe.change('D')
newWeek = timeframe.change('W')

// running high/low of the current day and week (with the bar where each was made)
var float curDayHigh = na
var float curDayLow = na
var int curDayHighBar = na
var int curDayLowBar = na
var float curWeekHigh = na
var float curWeekLow = na
var int curWeekHighBar = na
var int curWeekLowBar = na

var float pdh = na
var float pdl = na
var float pwh = na
var float pwl = na

var line pdhLine = na
var line pdlLine = na
var line pwhLine = na
var line pwlLine = na
var label pdhLabel = na
var label pdlLabel = na
var label pwhLabel = na
var label pwlLabel = na

if newDay
    line.delete(pdhLine)
    line.delete(pdlLine)
    label.delete(pdhLabel)
    label.delete(pdlLabel)
    pdhLine := na
    pdlLine := na
    pdhLabel := na
    pdlLabel := na

    pdh := curDayHigh
    pdl := curDayLow

    if showPDH and not na(pdh)
        pdhEnd = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        pdhLine := line.new(curDayHighBar, pdh, pdhEnd, pdh, color = pdhColor, width = lineWidth, extend = extend.none)
        pdhLabel := label.new(bar_index + labelOffsetBars, pdh - labelOffsetPrice, pdhText, style = label.style_label_left, textcolor = labelTextColor, color = prevDayLabelColor, size = labelSize)
        pdhLabel
    if showPDL and not na(pdl)
        pdlEnd = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        pdlLine := line.new(curDayLowBar, pdl, pdlEnd, pdl, color = pdlColor, width = lineWidth, extend = extend.none)
        pdlLabel := label.new(bar_index + labelOffsetBars, pdl - labelOffsetPrice, pdlText, style = label.style_label_left, textcolor = labelTextColor, color = prevDayLabelColor, size = labelSize)
        pdlLabel

    curDayHigh := high
    curDayLow := low
    curDayHighBar := bar_index
    curDayLowBar := bar_index
    curDayLowBar
else
    if high >= nz(curDayHigh, high)
        curDayHigh := high
        curDayHighBar := bar_index
        curDayHighBar
    if low <= nz(curDayLow, low)
        curDayLow := low
        curDayLowBar := bar_index
        curDayLowBar

if newWeek
    line.delete(pwhLine)
    line.delete(pwlLine)
    label.delete(pwhLabel)
    label.delete(pwlLabel)
    pwhLine := na
    pwlLine := na
    pwhLabel := na
    pwlLabel := na

    pwh := curWeekHigh
    pwl := curWeekLow

    if showPWH and not na(pwh)
        pwhEnd = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        pwhLine := line.new(curWeekHighBar, pwh, pwhEnd, pwh, color = pwhColor, width = lineWidth, extend = extend.none)
        pwhLabel := label.new(bar_index + labelOffsetBars, pwh - labelOffsetPrice, pwhText, style = label.style_label_left, textcolor = labelTextColor, color = prevWeekLabelColor, size = labelSize)
        pwhLabel
    if showPWL and not na(pwl)
        pwlEnd = extendRight ? bar_index + labelOffsetBars : bar_index + extendBars
        pwlLine := line.new(curWeekLowBar, pwl, pwlEnd, pwl, color = pwlColor, width = lineWidth, extend = extend.none)
        pwlLabel := label.new(bar_index + labelOffsetBars, pwl - labelOffsetPrice, pwlText, style = label.style_label_left, textcolor = labelTextColor, color = prevWeekLabelColor, size = labelSize)
        pwlLabel

    curWeekHigh := high
    curWeekLow := low
    curWeekHighBar := bar_index
    curWeekLowBar := bar_index
    curWeekLowBar
else
    if high >= nz(curWeekHigh, high)
        curWeekHigh := high
        curWeekHighBar := bar_index
        curWeekHighBar
    if low <= nz(curWeekLow, low)
        curWeekLow := low
        curWeekLowBar := bar_index
        curWeekLowBar
// =======================================================================


if extendRight
    followEnd = bar_index + labelOffsetBars
    if not na(asiaHighLine)
        line.set_x2(asiaHighLine, followEnd)
    if not na(asiaLowLine)
        line.set_x2(asiaLowLine, followEnd)
    if not na(londonHighLine)
        line.set_x2(londonHighLine, followEnd)
    if not na(londonLowLine)
        line.set_x2(londonLowLine, followEnd)
    if not na(midnightLine)
        line.set_x2(midnightLine, followEnd)
    if not na(open2Line)
        line.set_x2(open2Line, followEnd)
    if not na(pdhLine)
        line.set_x2(pdhLine, followEnd)
    if not na(pdlLine)
        line.set_x2(pdlLine, followEnd)
    if not na(pwhLine)
        line.set_x2(pwhLine, followEnd)
    if not na(pwlLine)
        line.set_x2(pwlLine, followEnd)

if not na(asiaHighLabel)
    label.set_x(asiaHighLabel, bar_index + labelOffsetBars)
    label.set_y(asiaHighLabel, asiaHigh - labelOffsetPrice)
if not na(asiaLowLabel)
    label.set_x(asiaLowLabel, bar_index + labelOffsetBars)
    label.set_y(asiaLowLabel, asiaLow - labelOffsetPrice)
if not na(londonHighLabel)
    label.set_x(londonHighLabel, bar_index + labelOffsetBars)
    label.set_y(londonHighLabel, londonHigh - labelOffsetPrice)
if not na(londonLowLabel)
    label.set_x(londonLowLabel, bar_index + labelOffsetBars)
    label.set_y(londonLowLabel, londonLow - labelOffsetPrice)
if not na(midnightLabel)
    label.set_x(midnightLabel, bar_index + labelOffsetBars)
    label.set_y(midnightLabel, midnightPrice - labelOffsetPrice)
if not na(open2Label)
    label.set_x(open2Label, bar_index + labelOffsetBars)
    label.set_y(open2Label, open2Price - labelOffsetPrice)
if not na(pdhLabel)
    label.set_x(pdhLabel, bar_index + labelOffsetBars)
if not na(pdlLabel)
    label.set_x(pdlLabel, bar_index + labelOffsetBars)
if not na(pwhLabel)
    label.set_x(pwhLabel, bar_index + labelOffsetBars)
if not na(pwlLabel)
    label.set_x(pwlLabel, bar_index + labelOffsetBars)

plotshape(asiaStart, title = 'Asia Start', style = shape.circle, location = location.bottom, size = size.tiny, color = color.new(asiaHighColor, 70), display = display.none)
plotshape(londonStart, title = 'London Start', style = shape.circle, location = location.bottom, size = size.tiny, color = color.new(londonHighColor, 70), display = display.none)
plotshape(midnightTrigger, title = 'Midnight Open Bar', style = shape.circle, location = location.bottom, size = size.tiny, color = color.new(midnightColor, 70), display = display.none)
plotshape(open2Trigger, title = '08:30 Open Bar', style = shape.circle, location = location.bottom, size = size.tiny, color = color.new(open2Color, 70), display = display.none)


// ============================ NDOG / NWOG =============================
// Input settings
max_ndogs_to_show = input.int(1, "Maximum NDOGs to display", minval=1, maxval=50, group="NDOG / NWOG")
max_nwogs_to_show = input.int(1, "Maximum NWOGs to display", minval=1, maxval=50, group="NDOG / NWOG")
min_gap_size = input.float(0.0001, "Minimum gap size (points)", minval=0.0, step=0.0001, group="NDOG / NWOG")
show_labels = input.bool(true, "Show Gap Level Text on Lines", group="NDOG / NWOG") // Updated description
show_mid_level = input.bool(true, "Show Gap Mid Level Line", group="NDOG / NWOG") // Clarified input name
show_gap_fill = input.bool(true, "Fill Gap Area", group="NDOG / NWOG")
fill_transparency = input.int(85, "Fill Transparency", minval=0, maxval=100, group="NDOG / NWOG Style")

// Line extension settings (ATM Range Windows style - lines no longer extend forever)
extend_lines_right = input.bool(true, "Extend Lines To The Right", group="NDOG / NWOG", tooltip="On = lines and labels keep following price, ending near the current bar. Off = lines stop a fixed number of bars after the gap forms.")
extend_bars_fixed  = input.int(500, "Line Length After Gap (Bars)", minval=1, maxval=500, group="NDOG / NWOG", tooltip="Only used when Extend Lines To The Right is off")

// Label positioning and formatting
label_offset_bars = input.int(120, "Label Offset (bars from current)", minval=0, maxval=200, group="NDOG / NWOG Labels")
show_price_in_label = input.bool(true, "Show Price in Label", group="NDOG / NWOG Labels")
show_date_in_label = input.bool(true, "Show Date in Label", group="NDOG / NWOG Labels")

// Gap line colors and styles
ndog_color = input.color(color.rgb(40, 134, 211, 31), "NDOG Color", group="NDOG / NWOG Style")
nwog_color = input.color(color.rgb(121, 205, 190), "NWOG Color", group="NDOG / NWOG Style")
mid_color = input.color(color.gray, "Mid Level Color", group="NDOG / NWOG Style")
line_style = input.string("Solid", "Gap Line Style", options=["Solid", "Dashed", "Dotted"], group="NDOG / NWOG Style") // Clarified input name
mid_line_style = input.string("Dashed", "Mid Line Style", options=["Solid", "Dashed", "Dotted"], group="NDOG / NWOG Style")
line_width = input.int(1, "Line Width", minval=1, maxval=5, group="NDOG / NWOG Style")
label_text_color = input.color(#ffffff, "Label Text Color", group="NDOG / NWOG Style") // Added text color input

// Table to display gap information
show_table = input.bool(true, "Show Gap Info Table", group="NDOG / NWOG")
table_position = input.string("top_right", "Table Position", 
                              options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], 
                              group="NDOG / NWOG")

// Convert line style
get_line_style(style_string) =>
    switch style_string
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// Function to format date
get_formatted_date() =>
    current_time = time
    day_of_month = dayofmonth(current_time)
    month_name = switch month(current_time)
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        12 => "Dec"
        => "Jan"
    
    // Add ordinal suffix
    suffix = switch day_of_month
        1 => "st"
        2 => "nd"
        3 => "rd"
        21 => "st"
        22 => "nd"
        23 => "rd"
        31 => "st"
        => "th"
    
    month_name + " " + str.tostring(day_of_month) + suffix

// Function to create formatted label text
get_label_text(gap_type, gap_level, price) =>
    base_text = gap_type + " " + gap_level
    if show_date_in_label
        base_text := base_text + " " + get_formatted_date()
    if show_price_in_label
        base_text := base_text + " • " + str.tostring(price, "#.##")
    base_text

// Variables to track lines (updated to include mid-level lines)
var array<line> ndog_lines = array.new<line>()
var array<line> nwog_lines = array.new<line>()
var array<line> ndog_mid_lines = array.new<line>()
var array<line> nwog_mid_lines = array.new<line>()

// Variables to track labels (kept in sync with the line arrays above so they can be cleaned up and extended together)
var array<label> ndog_labels = array.new<label>()
var array<label> nwog_labels = array.new<label>()
var array<label> ndog_mid_labels = array.new<label>()
var array<label> nwog_mid_labels = array.new<label>()

// Variables to track gap fills
var array<linefill> ndog_fills = array.new<linefill>()
var array<linefill> nwog_fills = array.new<linefill>()

// Variables to store previous session closes
var float daily_close_459pm = na
var float weekly_close_friday_459pm = na

// Variables to track if we've processed opens
var bool daily_open_processed = false
var bool weekly_open_processed = false

// Function to clean old lines (accounts for 2 lines per gap + mid lines, and their matching labels)
clean_old_ndog_lines(lines_array, mid_lines_array, labels_array, mid_labels_array, fills_array) =>
    max_gaps = max_ndogs_to_show
    // Total lines = max_gaps * 2 (top/bottom) + max_gaps (mid) if mid is shown
    // We manage top/bottom and mid lines/labels in separate arrays for easier cleanup based on input settings
    
    // Clean top/bottom lines (2 per gap)
    while array.size(lines_array) > max_gaps * 2
        old_line = array.shift(lines_array)
        if not na(old_line)
            line.delete(old_line)

    // Clean top/bottom labels (2 per gap)
    while array.size(labels_array) > max_gaps * 2
        old_label = array.shift(labels_array)
        if not na(old_label)
            label.delete(old_label)

    // Clean mid lines (1 per gap)
    while array.size(mid_lines_array) > max_gaps
        old_line = array.shift(mid_lines_array)
        if not na(old_line)
            line.delete(old_line)

    // Clean mid labels (1 per gap)
    while array.size(mid_labels_array) > max_gaps
        old_label = array.shift(mid_labels_array)
        if not na(old_label)
            label.delete(old_label)

    // Clean fills (1 per gap)
    while array.size(fills_array) > max_gaps
        old_fill = array.shift(fills_array)
        if not na(old_fill)
            linefill.delete(old_fill)

clean_old_nwog_lines(lines_array, mid_lines_array, labels_array, mid_labels_array, fills_array) =>
    max_gaps = max_nwogs_to_show

    // Clean top/bottom lines (2 per gap)
    while array.size(lines_array) > max_gaps * 2
        old_line = array.shift(lines_array)
        if not na(old_line)
            line.delete(old_line)

    // Clean top/bottom labels (2 per gap)
    while array.size(labels_array) > max_gaps * 2
        old_label = array.shift(labels_array)
        if not na(old_label)
            label.delete(old_label)

    // Clean mid lines (1 per gap)
    while array.size(mid_lines_array) > max_gaps
        old_line = array.shift(mid_lines_array)
        if not na(old_line)
            line.delete(old_line)

    // Clean mid labels (1 per gap)
    while array.size(mid_labels_array) > max_gaps
        old_label = array.shift(mid_labels_array)
        if not na(old_label)
            label.delete(old_label)

    // Clean fills (1 per gap)
    while array.size(fills_array) > max_gaps
        old_fill = array.shift(fills_array)
        if not na(old_fill)
            linefill.delete(old_fill)

// Extends a set of lines/labels together to the same x position (used when Extend Lines To The Right is on)
extend_line_label_arrays(lines_array, labels_array, end_x) =>
    n_lines = array.size(lines_array)
    if n_lines > 0
        for i = 0 to n_lines - 1
            ln = array.get(lines_array, i)
            if not na(ln)
                line.set_x2(ln, end_x)
    n_labels = array.size(labels_array)
    if n_labels > 0
        for i = 0 to n_labels - 1
            lb = array.get(labels_array, i)
            if not na(lb)
                label.set_x(lb, end_x)


// Get current time in NY timezone - simplified approach
// Use `time("1", "America/New_York")` only once per bar for efficiency
var int current_time_ny = na
if barstate.ishistory or barstate.isrealtime
    current_time_ny := time("1", "America/New_York") // Get time in NY for the current bar

current_hour_ny = hour(current_time_ny, "America/New_York")
current_minute_ny = minute(current_time_ny, "America/New_York")
current_dayofweek_ny = dayofweek(current_time_ny, "America/New_York")

// Detect session changes more reliably using `time("1D", tz)` and `time("1W", tz)` changes
// Ensure timezone is consistent
ny_timezone = "America/New_York"
session_start = ta.change(time("1D", ny_timezone)) != 0
week_start = ta.change(time("1W", ny_timezone)) != 0

// Function to check if current time is 4:59 PM NY time (daily close)
is_daily_close_459pm() =>
    current_hour_ny == 16 and current_minute_ny == 59

// Function to check if current time is Friday 4:59 PM NY time (weekly close)
is_weekly_close_friday_459pm() =>
    current_dayofweek_ny == dayofweek.friday and current_hour_ny == 16 and current_minute_ny == 59

// Simplified gap detection - trigger on first bar of new session
// NDOG triggers on any new day start *unless* it's a Sunday week start
is_new_day_gap() =>
    session_start and not na(daily_close_459pm) and not (week_start and current_dayofweek_ny == dayofweek.sunday)

// Simplified weekly gap detection - only on Sunday start, takes priority over daily
is_new_week_gap() =>
    week_start and current_dayofweek_ny == dayofweek.sunday and not na(weekly_close_friday_459pm)

// Capture daily close at 4:59 PM or at the start of a new session (the previous bar's close)
if is_daily_close_459pm() or session_start
    // Use close[1] if it's the start of a new session (change in time("1D")), otherwise use current close
    daily_close_459pm := session_start ? close[1] : close
    daily_open_processed := false // Reset flag for the new day

// Capture weekly close at Friday 4:59 PM or at the start of a new week (the previous bar's close)
if is_weekly_close_friday_459pm() or (week_start and current_dayofweek_ny == dayofweek.sunday)
     // Use close[1] if it's the start of a new week, otherwise use current close
    weekly_close_friday_459pm := (week_start and current_dayofweek_ny == dayofweek.sunday) ? close[1] : close
    weekly_open_processed := false // Reset flag for the new week

// --- Gap Creation Logic ---

// Create NDOG when a new day session starts and it's not the Sunday weekly open
if show_ndog and is_new_day_gap() and not daily_open_processed and not na(daily_close_459pm)
    gap_size = open - daily_close_459pm
    if math.abs(gap_size) > min_gap_size // Only show if gap is larger than minimum size
        // Calculate gap levels
        gap_top = math.max(open, daily_close_459pm)
        gap_bottom = math.min(open, daily_close_459pm)
        gap_mid = (gap_top + gap_bottom) / 2

        // Create lines for the gap
        var line top_line = na
        var line bottom_line = na
        var line mid_line = na
        var label top_label = na
        var label bottom_label = na
        var label mid_label = na

        line_end = extend_lines_right ? bar_index + label_offset_bars : bar_index + extend_bars_fixed

        if not na(gap_top) and not na(gap_bottom)
            top_line := line.new(bar_index, gap_top, line_end, gap_top, color=ndog_color, style=get_line_style(line_style), width=line_width, extend=extend.none)
            bottom_line := line.new(bar_index, gap_bottom, line_end, gap_bottom, 
                                  color=ndog_color, style=get_line_style(line_style), width=line_width, extend=extend.none)
            
            // Add text to lines if enabled
            if show_labels
                // Position labels at the right side of the screen with offset
                label_x = bar_index + label_offset_bars                
                top_label := label.new(label_x, gap_top, get_label_text("NDOG", "High", gap_top), 
                         color=ndog_color, textcolor=label_text_color, 
                         style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                bottom_label := label.new(label_x, gap_bottom, get_label_text("NDOG", "Low", gap_bottom), 
                         color=ndog_color, textcolor=label_text_color, 
                         style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                array.push(ndog_labels, top_label)
                array.push(ndog_labels, bottom_label)
              // Add lines to array
            array.push(ndog_lines, top_line)
            array.push(ndog_lines, bottom_line)
            
            // Create mid level line if enabled
            if show_mid_level
                mid_line := line.new(bar_index, gap_mid, line_end, gap_mid,
                                   color=mid_color, style=get_line_style(mid_line_style), width=line_width, extend=extend.none)
                if show_labels
                    label_x = bar_index + label_offset_bars                    
                    mid_label := label.new(label_x, gap_mid, get_label_text("NDOG", "Mid", gap_mid), 
                             color=mid_color, textcolor=label_text_color, 
                             style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                    array.push(ndog_mid_labels, mid_label)
                array.push(ndog_mid_lines, mid_line)

            // Fill the area between the NDOG top and bottom lines
            if show_gap_fill
                ndog_fill = linefill.new(top_line, bottom_line, color=color.new(ndog_color, fill_transparency))
                array.push(ndog_fills, ndog_fill)

            // Clean old lines (manage main lines and mid lines/labels separately)
            clean_old_ndog_lines(ndog_lines, ndog_mid_lines, ndog_labels, ndog_mid_labels, ndog_fills)

            // Mark as processed for this session
            daily_open_processed := true

// Create NWOG when market opens Sunday 6 PM (after Friday 4:59 PM close)
if show_nwog and is_new_week_gap() and not weekly_open_processed and not na(weekly_close_friday_459pm)
    gap_size = open - weekly_close_friday_459pm
    if math.abs(gap_size) > min_gap_size // Only show if gap is larger than minimum size
        // Calculate gap levels
        gap_top = math.max(open, weekly_close_friday_459pm)
        gap_bottom = math.min(open, weekly_close_friday_459pm)
        gap_mid = (gap_top + gap_bottom) / 2

        // Create lines for the gap
        var line top_line = na
        var line bottom_line = na
        var line mid_line = na
        var label top_label = na
        var label bottom_label = na
        var label mid_label = na

        line_end = extend_lines_right ? bar_index + label_offset_bars : bar_index + extend_bars_fixed

        if not na(gap_top) and not na(gap_bottom)
            top_line := line.new(bar_index, gap_top, line_end, gap_top, color=nwog_color, style=get_line_style(line_style), width=line_width, extend=extend.none) 
            bottom_line := line.new(bar_index, gap_bottom, line_end, gap_bottom, 
                                  color=nwog_color, style=get_line_style(line_style), width=line_width, extend=extend.none)
            
            // Add text to lines if enabled
            if show_labels
                // Position labels at the right side of the screen with offset
                label_x = bar_index + label_offset_bars                
                top_label := label.new(label_x, gap_top, get_label_text("NWOG", "High", gap_top), 
                         color=nwog_color, textcolor=label_text_color, 
                         style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                bottom_label := label.new(label_x, gap_bottom, get_label_text("NWOG", "Low", gap_bottom), 
                         color=nwog_color, textcolor=label_text_color, 
                         style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                array.push(nwog_labels, top_label)
                array.push(nwog_labels, bottom_label)

            // Add lines to array
            array.push(nwog_lines, top_line)
            array.push(nwog_lines, bottom_line)
            
            // Create mid level line if enabled
            if show_mid_level
                mid_line := line.new(bar_index, gap_mid, line_end, gap_mid,
                                   color=mid_color, style=get_line_style(mid_line_style), width=line_width, extend=extend.none)
                if show_labels
                    label_x = bar_index + label_offset_bars                    
                    mid_label := label.new(label_x, gap_mid, get_label_text("NWOG", "Mid", gap_mid), 
                             color=mid_color, textcolor=label_text_color, 
                             style=label.style_label_right, size=size.small, xloc=xloc.bar_index)
                    array.push(nwog_mid_labels, mid_label)
                array.push(nwog_mid_lines, mid_line)

            // Fill the area between the NWOG top and bottom lines
            if show_gap_fill
                nwog_fill = linefill.new(top_line, bottom_line, color=color.new(nwog_color, fill_transparency))
                array.push(nwog_fills, nwog_fill)

            // Clean old lines (manage main lines and mid lines/labels separately)
            clean_old_nwog_lines(nwog_lines, nwog_mid_lines, nwog_labels, nwog_mid_labels, nwog_fills)

            // Mark as processed for this session
            weekly_open_processed := true

// Keep active gaps' lines/labels following price when "Extend Lines To The Right" is on (mirrors ATM Range Windows)
if extend_lines_right and barstate.islast
    follow_end = bar_index + label_offset_bars
    extend_line_label_arrays(ndog_lines, ndog_labels, follow_end)
    extend_line_label_arrays(ndog_mid_lines, ndog_mid_labels, follow_end)
    extend_line_label_arrays(nwog_lines, nwog_labels, follow_end)
    extend_line_label_arrays(nwog_mid_lines, nwog_mid_labels, follow_end)

// Note: Lines now stop at a fixed point instead of running to the edge of the chart.
// Labels are created separately to show gap level names.

// Plot gap fill areas (optional background fill) - This would require tracking gap areas
// and using fill() which is more complex with dynamic lines. Let's keep it simple
// for now and maybe add fill logic in a later iteration if needed.
// show_fill = input.bool(false, "Fill Gap Areas", group="NDOG / NWOG")
// fill_transparency = input.int(90, "Fill Transparency", minval=0, maxval=100, group="NDOG / NWOG Style")


get_table_position() =>
    switch table_position
        "top_left" => position.top_left
        "top_center" => position.top_center
        "top_right" => position.top_right        
        "middle_left" => position.middle_left
        "middle_center" => position.middle_center
        "middle_right" => position.middle_right
        "bottom_left" => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right" => position.bottom_right
        => position.top_right

// Create information table
if show_table and barstate.islast // Only update table on the last bar for performance
    var info_table = table.new(get_table_position(), 5, 4, bgcolor=#ffffff, border_width=1)
    
    // Clear table content (keep header row for clarity)
    table.cell(info_table, 0, 1, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 1, 1, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 2, 1, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 3, 1, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 4, 1, "", text_color=#000000, bgcolor=#ffffff)

    table.cell(info_table, 0, 2, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 1, 2, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 2, 2, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 3, 2, "", text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 4, 2, "", text_color=#000000, bgcolor=#ffffff)

    table.cell(info_table, 0, 3, "", text_color=#000000, bgcolor=#d3d3d3)
    table.cell(info_table, 1, 3, "", text_color=#000000, bgcolor=#d3d3d3)
    table.cell(info_table, 2, 3, "", text_color=#000000, bgcolor=#d3d3d3)
    table.cell(info_table, 3, 3, "", text_color=#000000, bgcolor=#d3d3d3)
    table.cell(info_table, 4, 3, "", text_color=#000000, bgcolor=#d3d3d3)


    // Headers (set once)
    if barstate.isfirst
        table.cell(info_table, 0, 0, "Gap Type", text_color=#000000, bgcolor=#c0c0c0) // Slightly darker header
        table.cell(info_table, 1, 0, "Count", text_color=#000000, bgcolor=#c0c0c0)
        table.cell(info_table, 2, 0, "Gap Status", text_color=#000000, bgcolor=#c0c0c0) // Clarified status
        table.cell(info_table, 3, 0, "Mid Level", text_color=#000000, bgcolor=#c0c0c0)
        table.cell(info_table, 4, 0, "Schedule (NY)", text_color=#000000, bgcolor=#c0c0c0) // Clarified schedule
        
    // NDOG info
    ndog_count = str.tostring(math.floor(array.size(ndog_lines) / 2))
    table.cell(info_table, 0, 1, "NDOG", text_color=ndog_color, bgcolor=#ffffff)
    table.cell(info_table, 1, 1, ndog_count, text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 2, 1, show_ndog ? "ON" : "OFF", text_color=show_ndog ? #008000 : #ff0000, bgcolor=#ffffff) // Use standard green/red
    table.cell(info_table, 3, 1, show_mid_level ? str.tostring(array.size(ndog_mid_lines)) : "OFF", text_color=show_mid_level ? mid_color : #ff0000, bgcolor=#ffffff)
    table.cell(info_table, 4, 1, "Close: 4:59PM\nOpen: 6:00PM", text_color=#000000, bgcolor=#ffffff)
    
    // NWOG info
    nwog_count = str.tostring(math.floor(array.size(nwog_lines) / 2))
    table.cell(info_table, 0, 2, "NWOG", text_color=nwog_color, bgcolor=#ffffff)
    table.cell(info_table, 1, 2, nwog_count, text_color=#000000, bgcolor=#ffffff)
    table.cell(info_table, 2, 2, show_nwog ? "ON" : "OFF", text_color=show_nwog ? #008000 : #ff0000, bgcolor=#ffffff)
    table.cell(info_table, 3, 2, show_mid_level ? str.tostring(array.size(nwog_mid_lines)) : "OFF", text_color=show_mid_level ? mid_color : #ff0000, bgcolor=#ffffff)
    table.cell(info_table, 4, 2, "Fri Close: 4:59PM\nSun Open: 6:00PM", text_color=#000000, bgcolor=#ffffff)
    
    // Current NY time info and Label Status
    if not na(current_hour_ny) and not na(current_minute_ny) and not na(current_dayofweek_ny)
        current_time_str = str.tostring(current_hour_ny, "#00") + ":" + str.tostring(current_minute_ny, "#00")
        day_names = array.from("", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")
        current_day_str = array.get(day_names, current_dayofweek_ny)
        table.cell(info_table, 0, 3, "NY Time", text_color=#000000, bgcolor=#d3d3d3)
        table.cell(info_table, 1, 3, current_day_str, text_color=#000000, bgcolor=#d3d3d3)
        table.cell(info_table, 2, 3, current_time_str, text_color=#000000, bgcolor=#d3d3d3)
        table.cell(info_table, 3, 3, show_labels ? "Labels ON" : "Labels OFF", text_color=show_labels ? #008000 : #ff0000, bgcolor=#d3d3d3)
        table.cell(info_table, 4, 3, "Eastern", text_color=#000000, bgcolor=#d3d3d3)

// Debug labels (optional - enabled by default for easier testing)
show_debug = input.bool(false, "Show Debug Labels", group="NDOG / NWOG Debug") // Changed back to false by default

if show_debug
    // Show when we capture closes (using label.new as these are bar-specific events)
    if is_daily_close_459pm()
        label.new(bar_index, high, "Daily Close 4:59PM\nClose: " + str.tostring(close), color=#0000ff, style=label.style_label_down, size=size.tiny)
    if is_weekly_close_friday_459pm()
        label.new(bar_index, high, "Weekly Close Fri 4:59PM\nClose: " + str.tostring(close), color=#ff0000, style=label.style_label_down, size=size.tiny)
    
    // Show when we detect opens/gaps with more detail (using label.new)
    if is_new_day_gap()
        gap_type = "NDOG (Daily)"        
        label.new(bar_index, low, gap_type + "\nOpen: " + str.tostring(open) + "\nPrev Close: " + str.tostring(daily_close_459pm), color=#0000ff, style=label.style_label_up, size=size.tiny)
    if is_new_week_gap()
        gap_type = "NWOG (Weekly)"
        label.new(bar_index, low, gap_type + "\nOpen: " + str.tostring(open) + "\nPrev Close: " + str.tostring(weekly_close_friday_459pm), color=#ff0000, style=label.style_label_up, size=size.tiny)
    
    // Show session changes (using label.new)
    if session_start and not (week_start and current_dayofweek_ny == dayofweek.sunday)
        label.new(bar_index, close, "New Day Start", color=#ffff00, style=label.style_label_left, size=size.tiny)
    if week_start and current_dayofweek_ny == dayofweek.sunday
        label.new(bar_index, close, "New Week Start (Sunday)", color=#ff8000, style=label.style_label_left, size=size.tiny)
